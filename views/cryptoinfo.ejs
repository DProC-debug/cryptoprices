<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= coin.name %> (<%= coin.symbol.toUpperCase() %>) | Crypto Prices</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/main/styles.css">
</head>

<body>
    <img class="circle-img cryptodetails" src="https://aleo.org/homepage.png" alt="">
    <main class="cryptoinfo">
        <a class="back-link" href="/"><i class="bi bi-arrow-left" aria-hidden="true"></i> All prices</a>

        <% const symbol = coin.symbol.toUpperCase(); %>
        <div class="cryptotoken">
            <div class="coin-title">
                <img class="cryptopic" src="<%= coin.image %>" alt="">
                <span><%= coin.name %></span>
                <span class="coin-symbol"><%= symbol %></span>
            </div>

            <div class="cryptoprice">
                <%= formatUsd(coin.current_price) %>
                <% if (coin.price_change_percentage_24h != null) { %>
                <span class="value-note <%= changeClass(coin.price_change_percentage_24h) %>"><%= formatPercent(coin.price_change_percentage_24h) %> (24h)</span>
                <% } %>
            </div>
        </div>

        <div class="market">
            <section class="otherinfo" aria-label="Market data">
                <div class="infobox">
                    <div>Market Cap</div>
                    <div class="cryptoprice" title="$<%= formatNumber(coin.market_cap) %>">
                        <%= formatCompactUsd(coin.market_cap) %>
                        <% if (coin.market_cap_rank) { %>
                        <span class="value-note">Rank #<%= coin.market_cap_rank %></span>
                        <% } %>
                    </div>
                </div>
                <div class="infobox">
                    <div>Circulating Supply</div>
                    <div class="cryptoprice" title="<%= formatNumber(coin.circulating_supply) %> <%= symbol %>">
                        <%= formatCompactNumber(coin.circulating_supply) %> <%= symbol %>
                    </div>
                </div>
                <div class="infobox">
                    <div>Total Supply</div>
                    <div class="cryptoprice" title="<%= formatNumber(coin.total_supply) %> <%= symbol %>">
                        <% if (coin.total_supply == null) { %>N/A<% } else { %><%= formatCompactNumber(coin.total_supply) %> <%= symbol %><% } %>
                    </div>
                </div>
                <div class="infobox">
                    <div>All Time High</div>
                    <div class="cryptoprice" title="<%= formatExactUsd(coin.ath) %>">
                        <%= formatUsd(coin.ath) %>
                        <% if (coin.ath_change_percentage != null) { %>
                        <span class="value-note <%= changeClass(coin.ath_change_percentage) %>"><%= formatPercent(coin.ath_change_percentage) %> from ATH</span>
                        <% } %>
                    </div>
                </div>
                <div class="infobox">
                    <div>ATH Date</div>
                    <div class="cryptoprice" title="<%= coin.ath_date %>">
                        <%= formatDate(coin.ath_date) %>
                        <span class="value-note"><%= formatTimeAgo(coin.ath_date) %></span>
                    </div>
                </div>
                <div class="infobox">
                    <div>All Time Low</div>
                    <div class="cryptoprice" title="<%= formatExactUsd(coin.atl) %>">
                        <%= formatUsd(coin.atl) %>
                        <% if (coin.atl_change_percentage != null) { %>
                        <span class="value-note <%= changeClass(coin.atl_change_percentage) %>"><%= formatPercent(coin.atl_change_percentage) %> from ATL</span>
                        <% } %>
                    </div>
                </div>
                <div class="infobox">
                    <div>ATL Date</div>
                    <div class="cryptoprice" title="<%= coin.atl_date %>">
                        <%= formatDate(coin.atl_date) %>
                        <span class="value-note"><%= formatTimeAgo(coin.atl_date) %></span>
                    </div>
                </div>
                <div class="infobox">
                    <div>Fully Diluted Valuation</div>
                    <div class="cryptoprice" title="$<%= formatNumber(coin.fully_diluted_valuation) %>">
                        <%= formatCompactUsd(coin.fully_diluted_valuation) %>
                    </div>
                </div>
            </section>

            <section class="chart" aria-label="<%= coin.name %> price chart">
                <div class="chart-header">
                    <div>
                        <h2 class="chart-title"><%= symbol %> / USD</h2>
                        <span class="chart-change" id="chart-change"></span>
                    </div>
                    <div class="range-group" role="group" aria-label="Chart range">
                        <% chartRanges.forEach(({ days, label }) => { %>
                        <button type="button" class="range-button" data-days="<%= days %>"
                            aria-pressed="<%= days === chart.days %>"><%= label %></button>
                        <% }) %>
                    </div>
                </div>
                <div class="chart-canvas-wrap">
                    <canvas id="cryptoChart" role="img" aria-label="<%= coin.name %> price in US dollars"></canvas>
                    <p class="chart-status" id="chart-status" role="status" hidden></p>
                </div>
            </section>
        </div>
    </main>

    <script type="application/json" id="chart-data"><%- JSON.stringify(chart).replace(/</g, "\\u003c") %></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.js"
        integrity="sha384-G436+Z2nlA8+PNoeRvWdxKbvOf8E/y+lYxqht2iBwNHTQDV5CJr3+AGVj8fGZi5t"
        crossorigin="anonymous" defer></script>
    <script src="/main/chart.js" defer></script>
</body>

</html>
