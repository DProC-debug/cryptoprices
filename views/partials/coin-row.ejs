<a class="each-box coin-link" href="/search?search=<%= encodeURIComponent(coin.id) %>">
    <div>
        <%= coin.market_cap_rank %>
    </div>
    <div><img class="crypto-image" src="<%= coin.image %>" alt="<%= coin.symbol %>-img"></div>
    <div>
        <%= coin.name %>
    </div>
    <div class="coin-price">$<%= coin.current_price %>
    </div>
</a>
